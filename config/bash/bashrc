# dd's suckless bashrc, XDG+
# modified: 26-05-14

[[ $- != *i* ]] && return

# XDG base directories
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
# ensure dirs exist (silent)
mkdir -p "$XDG_STATE_HOME/bash" "$XDG_CACHE_HOME" 2>/dev/null

# PATH (clean & minimal)
export PATH="$HOME/.local/bin:$PATH"
export PATH="/opt/scripts:$PATH" # personal scripts (better place?)

# EDITOR
export EDITOR="${EDITOR:-fresh}" # fresh editor
export VISUAL="${VISUAL:-$EDITOR}"

# HISTORY XDG+
export HISTFILE="$XDG_STATE_HOME/bash/history"
export HISTTIMEFORMAT="%y%m%d_%T - "
export HISTCONTROL=ignoredups:erasedups
export HISTSIZE=100000
export HISTFILESIZE=10000000
shopt -s histappend

# useful shopt
shopt -s autocd cdspell cmdhist dotglob expand_aliases checkwinsize
bind 'set completion-ignore-case on'

# ALIASES
alias ls='ls -alhGF --color=auto --group-directories-first'
alias ll='ls -lahF'
alias cls='clear'
alias cp='cp -iv'
alias mv='mv -iv'
alias rm='rm -i --preserve-root'
alias mkdir='mkdir -p'
alias ping='ping -v4 -c 5'
alias grep='grep --color=auto'
alias diff='diff --color=auto'
alias update='sudo apt update && sudo apt full-upgrade -y'

# NALA over apt
apt() {
  command nala "$@"
}
sudo() {
  if [ "$1" = "apt" ]; then
    shift
    command sudo nala "$@"
  else
    command sudo "$@"
  fi
}


# Prompt (full Kali-style box)
PROMPT_SYMBOL="${PROMPT_SYMBOL:-@}" # kali symbol = ㉿
PS1="\[\033[01;32m\]┌──(\[\033[01;32m\]\u${PROMPT_SYMBOL}\h\[\033[01;32m\])─[\[\033[01;34m\]\w\[\033[01;32m\]]\n└─\[\033[01;32m\]\$\[\033[00m\] "
# PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ ' # cleaner, lighter, toggle above 2 lines

# dircolors + LESS colors (if available)
if [ -x /usr/bin/dircolors ]; then
    eval "$(dircolors -b)"
fi


# Bridge VeraCrypt Z: into WSL if already unlocked on Windows side
[ -x ~/.local/bin/mount-veracrypt-z.sh ] && ~/.local/bin/mount-veracrypt-z.sh

# Bridge network drive M: (media share) into WSL if already connected
[ -x ~/.local/bin/mount-media-m.sh ] && ~/.local/bin/mount-media-m.sh

# Bridge network drive T: (fileserver, incl. bethel folder) into WSL if already connected
[ -x ~/.local/bin/mount-fileserver-t.sh ] && ~/.local/bin/mount-fileserver-t.sh
